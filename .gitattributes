# 统一换行，避免 Windows/macOS/Linux 之间来回改行尾造成假 diff
* text=auto eol=lf

# 明确二进制，别让 git 去猜（也别做行尾转换）
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary

# Windows 脚本保持 CRLF（给 cmd/PowerShell/记事本用）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 这些文件只在本地/生成，不做 diff 展示
docs/*.png -diff
assets/pets/**/*.gif -diff
